# Sarvam AI API Key
SARVAM_API_KEY=your_sarvam_api_key_here

# STT Configuration
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_STT_MODEL=saaras:v3-realtime
STT_LANGUAGE_CODE=en-IN

# TTS Configuration
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
TTS_LANGUAGE_CODE=en-IN

# LLM Configuration
SARVAM_LLM_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_LLM_MODEL=sarvam-105b-conversations

# VAD Tunables
VAD_SILENCE_HANGOVER_MS=650
VAD_BARGE_IN_MIN_DURATION_MS=300
VAD_ENERGY_THRESHOLD=0.015

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
